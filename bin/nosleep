#!/bin/zsh -f
# Работа при закрытой крышке: pmset disablesleep - единственный рычаг,
# который переживает clamshell sleep (caffeinate и power assertions - нет).
#
#   nosleep <команда ...>   флаг включён, пока идёт команда. Сессий может быть
#                           несколько, флаг снимается после выхода последней
#   nosleep on              ручной режим, держится до nosleep off
#   nosleep for 1h|90m|30   не спать заданное время (без единиц - минуты)
#   nosleep off             снять ручной режим и таймеры (сессии не трогает)
#   nosleep off --force     снять всё: ручной режим, сессии, флаг
#   nosleep status          для человека
#   nosleep state           key=value для значка в панели меню
#   nosleep lang            ru или en: язык сообщений (для install.sh)
#
# pmset вызывается через `sudo -n`: без правила в /etc/sudoers.d (см. README)
# пароль никогда не спрашивается, а команда падает с понятной ошибкой.

emulate zsh
setopt extended_glob
zmodload zsh/system

# launchd и GUI-приложения запускают с урезанным PATH.
path+=(/usr/bin /bin /usr/sbin /sbin)

NOSLEEP_DIR=${NOSLEEP_DIR:-$HOME/.nosleep}
SESSIONS=$NOSLEEP_DIR/sessions
MANUAL=$NOSLEEP_DIR/manual
LOCK=$NOSLEEP_DIR/lock

# Язык сообщений, как у значка: ru при регионе RU или русском языке системы,
# иначе en. NOSLEEP_LANG=ru|en перекрывает. AppleLocale вида en_US@rg=ruzzzz:
# регион из @rg= главнее.
ui_lang() {
  [[ -n $NOSLEEP_LANG ]] && { print -r -- $NOSLEEP_LANG; return }
  local loc lang region
  loc=$(defaults read -g AppleLocale 2>/dev/null)
  lang=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2s/[^a-zA-Z-]//gp')
  if [[ $loc == *@rg=* ]]; then region=${${loc#*@rg=}[1,2]}; else region=${${loc%%@*}#*_}; fi
  [[ ${region:l} == ru || $lang == ru* ]] && print ru || print en
}
t() { [[ $NOSLEEP_LANG == ru ]] && print -r -- $1 || print -r -- $2 }
# state читает значок каждые 5 с, ему язык не нужен.
[[ $1 == state ]] || NOSLEEP_LANG=$(ui_lang)

die() { print -u2 -- "nosleep: $*"; exit 1 }

set_flag() {
  sudo -n pmset -a disablesleep $1 >/dev/null 2>&1 \
    || { print -u2 -- "nosleep: $(t "sudo без пароля для pmset не настроен (см. README)" "passwordless sudo for pmset is not set up (see README)")"; return 1 }
}

flag_on() { pmset -g | grep -q 'SleepDisabled[[:space:]]*1' }

# Живые сессии; файлы мёртвых (kill -9, краш) удаляются по дороге.
live_sessions() {
  local f
  reply=()
  for f in $SESSIONS/<->(N); do
    if kill -0 ${f:t} 2>/dev/null; then reply+=$f; else rm -f $f; fi
  done
}

# Таймер - это фоновая сессия `sleep`, её файл начинается с этой метки.
# NosleepBar ищет эту метку в `nosleep state` (menubar/NosleepBar.swift).
TIMER_LABEL="таймер до"

# Отменить таймеры: убить их sleep, тогда их nosleep выходит сам.
cancel_timers() {
  local f
  live_sessions
  for f in $reply; do
    [[ $(<$f) == "$TIMER_LABEL "* ]] || continue
    pkill -TERM -P ${f:t} 2>/dev/null
    rm -f $f
  done
}

# Флаг 0, только если никто больше его не держит.
release() {
  live_sessions
  [[ -e $MANUAL ]] || (( $#reply )) || set_flag 0
}

# Все изменения состояния - под одной блокировкой, иначе выход одной сессии
# может снять флаг, только что поставленный другой.
typeset -i LOCK_FD=-1
lock() {
  (( LOCK_FD >= 0 )) && return
  mkdir -p $SESSIONS && : >> $LOCK && zsystem flock -t 10 -f LOCK_FD $LOCK || die "$(t "не взять блокировку" "cannot take lock") $LOCK"
}
unlock() {
  (( LOCK_FD >= 0 )) || return 0
  zsystem flock -u $LOCK_FD
  LOCK_FD=-1
}

# Регистрирует сессию и ставит флаг. Traps ставятся на верхнем уровне:
# EXIT, заданный внутри функции, в zsh срабатывает при выходе из функции.
start_session() {
  lock
  print -r -- "${NOSLEEP_LABEL:-$*}" > $ME
  set_flag 1 || { trap - EXIT; rm -f $ME; exit 1 }
  unlock
}

cmd_state() {
  local f
  live_sessions
  print -- "flag=$(flag_on && print 1 || print 0)"
  print -- "manual=$([[ -e $MANUAL ]] && print 1 || print 0)"
  print -- "sessions=$#reply"
  print -- "power=$(pmset -g batt | grep -q "'AC Power'" && print ac || print battery)"
  for f in $reply; do print -r -- "session=${f:t} $(<$f)"; done
}

cmd_status() {
  live_sessions
  if flag_on; then
    print -- "nosleep: ON - $(t "сон отключён, крышку можно закрывать" "sleep disabled, you can close the lid")"
  else
    print -- "nosleep: OFF - $(t "обычный сон" "normal sleep")"
  fi
  [[ -e $MANUAL ]] && print -- "  $(t "ручной режим (nosleep off, чтобы снять)" "manual mode (nosleep off to clear)")"
  local f what
  for f in $reply; do
    what=$(<$f)
    [[ $what == "$TIMER_LABEL "* ]] && what="$(t $TIMER_LABEL "timer until") ${what#$TIMER_LABEL }"
    print -r -- "  $(t сессия session) ${f:t}: $what"
  done
  return 0
}

case "$1" in
  status) cmd_status ;;
  state)  cmd_state ;;
  lang)   print -r -- $NOSLEEP_LANG ;;
  on)
    lock
    : > $MANUAL
    set_flag 1 && print -- "nosleep: ON ($(t "ручной режим, не забудь nosleep off" "manual mode, remember nosleep off"))"
    ;;
  for)
    secs=
    case $2 in
      <->h) secs=$(( ${2%h} * 3600 )) ;;
      <->m) secs=$(( ${2%m} * 60 )) ;;
      <->)  secs=$(( $2 * 60 )) ;;
      *)    die "$(t "длительность: 1h, 90m или 30 (минуты)" "duration: 1h, 90m or 30 (minutes)")" ;;
    esac
    (( secs > 0 )) || die "$(t "длительность должна быть больше нуля" "duration must be greater than zero")"
    until=$(date -v+${secs}S +%H:%M)
    NOSLEEP_LABEL="$TIMER_LABEL $until" nohup $0 sleep $secs </dev/null >/dev/null 2>&1 &!
    # Дождаться, пока таймер поставит флаг: иначе ошибка sudo потеряется.
    for _ in {1..20}; do flag_on && break; sleep 0.1; done
    flag_on || die "$(t "таймер не включился (sudo без пароля настроен? см. README)" "timer did not start (is passwordless sudo set up? see README)")"
    print -- "nosleep: ON $(t до until) $until"
    ;;
  off)
    lock
    rm -f $MANUAL
    cancel_timers
    if [[ $2 == --force ]]; then
      rm -f $SESSIONS/*(N)
      set_flag 0 && print -- "nosleep: OFF"
    else
      release || exit 1
      live_sessions
      if (( $#reply )); then
        print -- "nosleep: $(t "ручной режим снят, флаг держат сессии" "manual mode cleared, sessions still holding the flag"): $#reply"
      else
        print -- "nosleep: OFF"
      fi
    fi
    ;;
  ""|-h|--help)
    print -u2 -- "usage: nosleep <$(t команда command) ...> | nosleep on | for 1h | off [--force] | status | state"
    exit 2
    ;;
  *)
    ME=$SESSIONS/$$
    # Снятие - только в EXIT. INT/HUP/TERM лишь превращаем в выход: пока
    # дочерний процесс жив, zsh ждёт его, поэтому Ctrl-C, который claude
    # перехватывает, сессию не роняет. Traps до start_session, чтобы сигнал
    # между установкой флага и trap не оставил флаг висеть.
    trap 'lock; rm -f $ME; release' EXIT
    trap 'exit 130' INT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    start_session "$@"
    "$@"
    exit $?
    ;;
esac
